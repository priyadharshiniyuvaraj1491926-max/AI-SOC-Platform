# Copy to .env. Set APP_SECRET_KEY to a fresh random value before running the API.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-before-use
DATABASE_URL=sqlite:///../data/aisoc.db
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
MAX_UPLOAD_MB=10
FAILED_LOGIN_THRESHOLD=5
BRUTE_FORCE_THRESHOLD=8
PORT_SCAN_THRESHOLD=8
FAILED_LOGIN_WINDOW_MINUTES=15
CORRELATION_WINDOW_MINUTES=30

# Public API origin only. Never put backend credentials in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:8009
